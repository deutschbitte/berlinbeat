---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)]">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-6 text-sm text-[var(--fg-muted)] sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <p>&copy; {year} Berlin Beat</p>
    <div class="flex gap-4">
      <a href="/tags/" class="transition-colors hover:text-[var(--fg)]">Tags</a>
      <a href="/about/" class="transition-colors hover:text-[var(--fg)]">About</a>
      <a href="/contact/" class="transition-colors hover:text-[var(--fg)]">Contact</a>
      <a href="/rss.xml" class="transition-colors hover:text-[var(--fg)]">RSS</a>
      <a href="/privacy-policy/" class="transition-colors hover:text-[var(--fg)]">Privacy Policy</a>
    </div>
  </div>
</footer>
