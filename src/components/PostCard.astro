---
import SmartImage from './SmartImage.astro';
import { postHref, typeLabel, formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<a
  href={postHref(post)}
  data-type={post.data.type}
  class="group flex flex-col overflow-hidden rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] transition-colors hover:border-[var(--fg-muted)]"
>
  <div class="aspect-[4/3] overflow-hidden bg-[var(--border)]">
    {post.data.coverImage && (
      <SmartImage
        src={post.data.coverImage}
        alt={post.data.coverImageAlt ?? post.data.title}
        class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        widths={[300, 500]}
        sizes="(min-width: 1024px) 25vw, (min-width: 640px) 30vw, 45vw"
      />
    )}
  </div>
  <div class="flex flex-1 flex-col gap-0.5 p-2.5">
    <h3 class="line-clamp-2 text-sm font-medium leading-snug text-[var(--fg)]">
      {post.data.title}
    </h3>
    <p class="mt-auto pt-1 text-xs text-[var(--fg-muted)]">
      {typeLabel(post)} · {formatDate(post.data.date)}
    </p>
  </div>
</a>
