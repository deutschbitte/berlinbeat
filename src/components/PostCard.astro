---
import SmartImage from './SmartImage.astro';
import { postHref, typeLabel, formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const meta = [post.data.band, post.data.venue].filter(Boolean).join(' — ');
---

<a
  href={postHref(post)}
  class="group flex flex-col overflow-hidden rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] transition-colors hover:border-[var(--fg-muted)]"
>
  <div class="aspect-[4/3] overflow-hidden bg-[var(--border)]">
    {post.data.coverImage && (
      <SmartImage
        src={post.data.coverImage}
        alt={post.data.coverImageAlt ?? post.data.title}
        class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        widths={[400, 800]}
        sizes="(min-width: 768px) 33vw, 100vw"
      />
    )}
  </div>
  <div class="flex flex-1 flex-col gap-1 p-3">
    <span class="text-xs text-[var(--fg-muted)]">
      {typeLabel(post)}
    </span>
    <h3 class="text-balance text-base font-medium leading-snug text-[var(--fg)]">
      {post.data.title}
    </h3>
    {meta && <p class="text-sm text-[var(--fg-muted)]">{meta}</p>}
    <p class="mt-auto pt-1 text-xs text-[var(--fg-muted)]">
      {formatDate(post.data.date)}
    </p>
  </div>
</a>
