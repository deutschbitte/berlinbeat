---
import PostGrid from './PostGrid.astro';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

const counts = {
  interview: posts.filter((p) => p.data.type === 'interview').length,
  review: posts.filter((p) => p.data.type === 'review').length,
  photos: posts.filter((p) => p.data.type === 'photos').length,
};
---

<div>
  <div class="mb-6 flex items-center gap-2">
    <label for="type-filter" class="text-sm text-[var(--fg-muted)]">Show</label>
    <div class="relative">
      <select
        id="type-filter"
        class="appearance-none rounded-full border border-[var(--border)] bg-[var(--bg)] py-1.5 pl-3 pr-8 text-sm text-[var(--fg)] transition-colors hover:border-[var(--fg-muted)] focus:border-[var(--fg-muted)] focus:outline-none"
      >
        <option value="all">All ({posts.length})</option>
        <option value="interview">Interviews ({counts.interview})</option>
        <option value="review">Reviews ({counts.review})</option>
        <option value="photos">Photos ({counts.photos})</option>
      </select>
      <svg
        class="pointer-events-none absolute right-2.5 top-1/2 size-3 -translate-y-1/2 text-[var(--fg-muted)]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </div>
  </div>

  <PostGrid posts={posts} />

  <p id="post-browser-empty" class="hidden text-[var(--fg-muted)]">No posts match this filter.</p>
</div>

<script is:inline>
  (function () {
    const select = document.getElementById('type-filter');
    const emptyMessage = document.getElementById('post-browser-empty');

    function applyFilter() {
      const value = select.value;
      const cards = document.querySelectorAll('[data-type]');
      let visibleCount = 0;
      cards.forEach((card) => {
        const matches = value === 'all' || card.dataset.type === value;
        card.classList.toggle('hidden', !matches);
        if (matches) visibleCount++;
      });
      emptyMessage?.classList.toggle('hidden', visibleCount > 0);
    }

    select?.addEventListener('change', applyFilter);
  })();
</script>
