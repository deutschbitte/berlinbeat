---
import type { Page } from 'astro';
import Layout from '../layouts/Layout.astro';
import PostGrid from './PostGrid.astro';
import Pagination from './Pagination.astro';
import type { Post } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  page: Page<Post>;
}

const { title, description, page } = Astro.props;
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-5 py-8 sm:px-8 sm:py-10">
    <h1 class="text-2xl font-medium sm:text-3xl">{title}</h1>

    <div class="mt-6">
      <PostGrid posts={page.data} />
    </div>

    <Pagination page={page} />
  </section>
</Layout>
