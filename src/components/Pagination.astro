---
import type { Page } from 'astro';

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;
---

{page.lastPage > 1 && (
  <nav class="mt-12 flex items-center justify-between text-sm" aria-label="Pagination">
    {page.url.prev ? (
      <a href={page.url.prev} class="text-[var(--fg)] hover:underline">&larr; Newer</a>
    ) : <span />}
    <span class="text-[var(--fg-muted)]">Page {page.currentPage} of {page.lastPage}</span>
    {page.url.next ? (
      <a href={page.url.next} class="text-[var(--fg)] hover:underline">Older &rarr;</a>
    ) : <span />}
  </nav>
)}
