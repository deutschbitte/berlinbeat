---
import Layout from '../layouts/Layout.astro';
import PostBrowser from './PostBrowser.astro';
import type { Post } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  posts: Post[];
}

const { title, description, posts } = Astro.props;
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-5 py-8 sm:px-8 sm:py-10">
    <h1 class="text-2xl font-medium sm:text-3xl">{title}</h1>
    <p class="mt-1 max-w-xl text-[var(--fg-muted)]">{description}</p>

    <div class="mt-6">
      <PostBrowser posts={posts} />
    </div>
  </section>
</Layout>
