---
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle light and dark theme"
  class="grid size-9 shrink-0 place-items-center rounded-full border border-[var(--border)] text-[var(--fg)] transition-colors hover:border-[var(--fg)]"
>
  <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="hidden size-4">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="size-4">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    const root = document.documentElement;
    const button = document.getElementById('theme-toggle');
    const sun = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');

    function sync() {
      const isLight = root.classList.contains('light');
      sun?.classList.toggle('hidden', !isLight);
      moon?.classList.toggle('hidden', isLight);
    }

    button?.addEventListener('click', () => {
      root.classList.toggle('light');
      localStorage.setItem('bb-theme', root.classList.contains('light') ? 'light' : 'dark');
      sync();
    });

    sync();
  })();
</script>
