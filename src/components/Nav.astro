---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/interviews/', label: 'Interviews' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/photos/', label: 'Photos' },
];

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--bg)]/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-2.5 sm:px-8">
    <a href="/" class="text-sm font-medium tracking-tight text-[var(--fg)]">
      Berlin Beat
    </a>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[var(--fg-muted)]">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'transition-colors hover:text-[var(--fg)]',
            path.startsWith(link.href) && 'text-[var(--fg)] underline underline-offset-4',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <ThemeToggle />
  </nav>
</header>
