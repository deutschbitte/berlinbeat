---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="What Berlin Beat is and who's behind it.">
  <article class="mx-auto max-w-2xl px-5 py-8 sm:px-8 sm:py-10">
    <h1 class="text-2xl font-medium sm:text-3xl">About Berlin Beat</h1>
    <div class="prose mt-4 max-w-none">
      <p>
        Berlin Beat is an independent music publication covering the bands, venues, and scenes
        that make up Berlin's live music underground — interviews with artists passing through
        the city, reviews of records and shows, and photography from the pit.
      </p>
      <p>
        Replace this placeholder copy with your own About page content once the site is live.
      </p>
    </div>
  </article>
</Layout>
