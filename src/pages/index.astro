---
import Layout from '../layouts/Layout.astro';
import PostBrowser from '../components/PostBrowser.astro';
import { getAllPosts } from '../lib/posts';

const posts = await getAllPosts();
---

<Layout title="Berlin Beat">
  <section class="mx-auto max-w-6xl px-5 pb-2 pt-6 sm:px-8 sm:pt-10">
    <p class="max-w-xl text-balance text-sm text-[var(--fg-muted)]">
      Interviews, reviews &amp; photos from Berlin's music underground
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-12 sm:px-8">
    <PostBrowser posts={posts} />
  </section>
</Layout>
