---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import SmartImage from '../components/SmartImage.astro';
import { getAllPosts, postHref, typeLabel, formatDate } from '../lib/posts';

const posts = await getAllPosts();
const [hero, ...rest] = posts;
const grid = rest.slice(0, 11);
---

<Layout title="Berlin Beat">
  <section class="mx-auto max-w-6xl px-5 pb-4 pt-6 sm:px-8 sm:pt-10">
    <p class="max-w-xl text-balance text-sm text-[var(--fg-muted)]">
      Interviews, reviews &amp; photos from Berlin's music underground
    </p>
  </section>

  {hero && (
    <section class="mx-auto max-w-6xl px-5 pb-8 sm:px-8">
      <a href={postHref(hero)} class="group grid gap-4 sm:grid-cols-2 sm:items-center">
        {hero.data.coverImage && (
          <div class="aspect-[4/3] overflow-hidden rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] sm:order-2">
            <SmartImage
              src={hero.data.coverImage}
              alt={hero.data.coverImageAlt ?? hero.data.title}
              class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              widths={[640, 960]}
              sizes="(min-width: 640px) 50vw, 100vw"
            />
          </div>
        )}
        <div class="sm:order-1">
          <span class="text-xs text-[var(--fg-muted)]">
            {typeLabel(hero)}
          </span>
          <h1 class="mt-1 text-balance text-2xl font-medium leading-tight sm:text-3xl">
            {hero.data.title}
          </h1>
          {hero.data.excerpt && (
            <p class="mt-2 max-w-md text-[var(--fg-muted)]">{hero.data.excerpt}</p>
          )}
          <p class="mt-2 text-xs text-[var(--fg-muted)]">
            {formatDate(hero.data.date)}
          </p>
        </div>
      </a>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-5 pb-12 sm:px-8">
    <h2 class="text-sm text-[var(--fg-muted)]">
      Latest
    </h2>
    <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {grid.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</Layout>
