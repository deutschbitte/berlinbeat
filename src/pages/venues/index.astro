---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts, uniqueVenues, slugify } from '../../lib/posts';

const posts = await getAllPosts();
const venues = uniqueVenues(posts).map((venue) => {
  const slug = slugify(venue);
  return {
    name: venue,
    slug,
    count: posts.filter((p) => p.data.venue && slugify(p.data.venue) === slug).length,
  };
});
---

<Layout title="Venues" description="Berlin venues covered by Berlin Beat.">
  <section class="mx-auto max-w-6xl px-5 py-8 sm:px-8 sm:py-10">
    <h1 class="text-2xl font-medium sm:text-3xl">Venues</h1>
    <p class="mt-1 max-w-xl text-[var(--fg-muted)]">Shows and photos, sorted by venue.</p>

    {venues.length > 0 ? (
      <ul class="mt-5 grid grid-cols-1 gap-1.5 sm:grid-cols-2 lg:grid-cols-3">
        {venues.map((venue) => (
          <li>
            <a
              href={`/venues/${venue.slug}/`}
              class="flex items-center justify-between rounded-lg border border-[var(--border)] px-3 py-2 transition-colors hover:border-[var(--fg-muted)]"
            >
              <span>{venue.name}</span>
              <span class="text-sm text-[var(--fg-muted)]">{venue.count}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-6 text-[var(--fg-muted)]">No venues tagged yet.</p>
    )}
  </section>
</Layout>
