---
import Layout from '../layouts/Layout.astro';

const links = [
  { name: 'Example Venue', url: 'https://example.com', note: 'Concert venue' },
  { name: 'Example Label', url: 'https://example.com', note: 'Record label' },
  { name: 'Example Zine', url: 'https://example.com', note: 'Fellow music publication' },
];
---

<Layout title="Links" description="Venues, labels, and friends of Berlin Beat.">
  <article class="mx-auto max-w-2xl px-5 py-8 sm:px-8 sm:py-10">
    <h1 class="text-2xl font-medium sm:text-3xl">Links</h1>
    <p class="mt-1 text-[var(--fg-muted)]">Venues, labels, and friends of the publication.</p>

    <ul class="mt-5 divide-y divide-[var(--border)]">
      {links.map((link) => (
        <li class="flex items-center justify-between py-2.5">
          <a href={link.url} class="font-medium hover:underline" target="_blank" rel="noopener noreferrer">
            {link.name}
          </a>
          <span class="text-sm text-[var(--fg-muted)]">{link.note}</span>
        </li>
      ))}
    </ul>
  </article>
</Layout>
